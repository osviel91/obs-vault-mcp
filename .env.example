# NAS WebDAV endpoint, including its WebDAV base path.
# Examples:
#   https://nas.example.net:5006/
#   https://nas.example.net/remote.php/dav/files/osvi/
WEBDAV_URL=https://nas.example.net/webdav/

# Path below the WebDAV endpoint containing the Obsidian vault.
# Use an empty value when WEBDAV_URL already points to the vault root.
WEBDAV_REMOTE_PATH=Obsidian/MyVault

# Common values: other, nextcloud, owncloud, sharepoint, sharepoint-ntlm, rclone
WEBDAV_VENDOR=other

WEBDAV_USERNAME=replace-me

# rclone requires obscured passwords in backend configuration.
# Generate this value with:
# docker run --rm rclone/rclone:latest obscure 'your-real-password'
WEBDAV_PASSWORD_OBSCURED=replace-me

# Pull changes from the NAS every 5 minutes.
SYNC_INTERVAL_SECONDS=300

# Container user/group used by markdown-vault-mcp.
# Adapt to the user owning Docker data on your host when necessary.
PUID=1000
PGID=1000
